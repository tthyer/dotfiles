#!/usr/bin/env bash
set -euo pipefail

# Ghostty launches this instead of the login shell directly so it gets
# Homebrew's bash 5 rather than whatever the GUI's PATH happens to find.
bash_bin=
for bash_path in /opt/homebrew/bin/bash /usr/local/bin/bash /bin/bash; do
  if [[ -x "$bash_path" ]]; then bash_bin="$bash_path"; break; fi
done
[[ -z "$bash_bin" ]] && { echo "No bash executable found." >&2; exit 127; }

exec "$bash_bin" --login "$@"
